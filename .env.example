# =============================================================================
# Google Ads MCP-server - exempel på miljövariabler
# Kopiera denna fil till ".env" och fyll i dina egna värden.
# ".env" ska ALDRIG committas till git (den ligger redan i .gitignore).
# =============================================================================

# ---- Test utan riktiga konton ----
# Sätt till "true" för att köra servern helt utan riktiga credentials - alla
# fyra plattformarna (Google/Meta/TikTok/Snapchat) svarar då med fejkad men
# realistisk testdata (se fake_data.py). Bra för att testa/chatta mot
# verktygen innan du har riktiga kontouppgifter. Låt stå på "false"/tomt för
# att köra mot riktiga konton.
MOCK_MODE=false

# ---- Google Ads API ----
# Developer token från ditt Google Ads Manager-konto (https://ads.google.com/aw/apicenter)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Valfritt: login-customer-id (MCC) om du anropar underkonton via ett manager-konto.
# Kan klistras in med eller utan bindestreck - normaliseras automatiskt av servern.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Autentisering: OAuth2 (rekommenderas för Google Ads API) ----
# OAuth-klient av typen "Desktop app", skapad i Google Cloud Console.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Genereras en gång lokalt (se README, avsnittet "Skaffa en refresh token").
GOOGLE_ADS_REFRESH_TOKEN=

# ---- Alternativ autentisering: service account + domain-wide delegation ----
# Fyll ENDAST i dessa två om du INTE använder OAuth-fälten ovan.
# Kräver att kontot administreras under en Google Workspace-domän som gett
# service accounten domain-wide delegation till Google Ads-scopet.
# GOOGLE_ADS_JSON_KEY_FILE_PATH=/secrets/service-account.json
# GOOGLE_ADS_IMPERSONATED_EMAIL=admin@dittforetag.se

# =============================================================================
# Meta (Facebook/Instagram) Ads, TikTok Ads och Snapchat Ads - ENDAST LÄSNING.
# Additiva: saknas dessa startar servern ändå (bara Google Ads är
# obligatoriskt) - respektive plattforms verktyg ger då ett tydligt fel
# om de anropas.
# =============================================================================

# ---- Meta (Facebook/Instagram) Ads ----
# Long-lived access token med minst "ads_read"-behörighet, från ett System
# User i Business Manager eller en app med Marketing API-åtkomst.
META_ACCESS_TOKEN=
# Valfritt - endast om du använder appsecret_proof.
META_APP_SECRET=
META_API_VERSION=v21.0

# ---- TikTok Ads ----
# Access token från TikTok for Business Marketing API (genereras via
# OAuth-auktorisering av ditt Developer App mot annonsörskontot).
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_VERSION=v1.3

# ---- Snapchat Ads ----
# OAuth2-uppgifter från en Snapchat Business-app. Access token förnyas
# automatiskt av servern via refresh_token - ingen manuell tokenhantering.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=

# Timeout (sekunder) för HTTP-anrop mot Meta/TikTok/Snapchat.
ADS_HTTP_TIMEOUT_SECONDS=30

# ---- MCP-server ----
# Delad hemlighet som klienter måste skicka som "Authorization: Bearer <token>".
# Generera t.ex. med: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=byt-mig-mot-en-lang-slumpad-strang

# Port och host servern lyssnar på. Railway/Render sätter PORT automatiskt.
PORT=8000
HOST=0.0.0.0

# Timeout (sekunder) för GAQL-queries och mutate-anrop mot Google Ads API.
GOOGLE_ADS_TIMEOUT_SECONDS=30
