# =============================================================================
# Google Ads MCP-server - exempel på miljövariabler
# Kopiera denna fil till ".env" och fyll i dina egna värden.
# ".env" ska ALDRIG committas till git (den ligger redan i .gitignore).
# =============================================================================

# ---- Google Ads API ----
# Developer token från ditt Google Ads Manager-konto (https://ads.google.com/aw/apicenter)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Valfritt: login-customer-id (MCC) om du anropar underkonton via ett manager-konto.
# Kan klistras in med eller utan bindestreck - normaliseras automatiskt av servern.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Autentisering: OAuth2 (rekommenderas för Google Ads API) ----
# OAuth-klient av typen "Desktop app", skapad i Google Cloud Console.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Genereras en gång lokalt (se README, avsnittet "Skaffa en refresh token").
GOOGLE_ADS_REFRESH_TOKEN=

# ---- Alternativ autentisering: service account + domain-wide delegation ----
# Fyll ENDAST i dessa två om du INTE använder OAuth-fälten ovan.
# Kräver att kontot administreras under en Google Workspace-domän som gett
# service accounten domain-wide delegation till Google Ads-scopet.
# GOOGLE_ADS_JSON_KEY_FILE_PATH=/secrets/service-account.json
# GOOGLE_ADS_IMPERSONATED_EMAIL=admin@dittforetag.se

# ---- MCP-server ----
# Delad hemlighet som klienter måste skicka som "Authorization: Bearer <token>".
# Generera t.ex. med: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=byt-mig-mot-en-lang-slumpad-strang

# Port och host servern lyssnar på. Railway/Render sätter PORT automatiskt.
PORT=8000
HOST=0.0.0.0

# Timeout (sekunder) för GAQL-queries och mutate-anrop mot Google Ads API.
GOOGLE_ADS_TIMEOUT_SECONDS=30
